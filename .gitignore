# Runtime files — created on first run, hold secrets and per-install state.
# Never commit these; see config.example.json for the shape.
config.json
state.json
*.json.tmp
# history.db* also covers SQLite sidecar files (history.db-journal, -wal,
# -shm), which use a dash and would slip past a history.db.* pattern.
history.db*

# Python
__pycache__/
*.pyc
venv/
.venv/
env/
*.egg-info/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
